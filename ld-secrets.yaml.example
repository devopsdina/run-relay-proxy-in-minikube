# ============================================================================
# LaunchDarkly Relay Proxy Secrets
# ============================================================================
relay:
  environment:
    # Replace with your actual SDK key
    LD_ENV_production: "YOUR_SDK_KEY_HERE"
    
    # Add more environments as needed
    # LD_ENV_staging: "YOUR_STAGING_SDK_KEY_HERE"
    # LD_ENV_development: "YOUR_DEV_SDK_KEY_HERE"
    
    # Redis password must match that set in the redis-secrets.yaml
    REDIS_PASSWORD: "YOUR_REDIS_PASSWORD_HERE"

