# DynamoDB Secrets Example
# Copy this file to dynamodb-secrets.yaml and DO NOT commit dynamodb-secrets.yaml
# 
# For LOCAL DynamoDB testing, these are fake credentials
# The local DynamoDB doesn't actually validate credentials

relay:
  environment:
    # Fake AWS credentials for local DynamoDB testing
    # DynamoDB Local doesn't validate these, but the LD Relay needs them set
    AWS_ACCESS_KEY_ID: "fakeAccessKeyId"
    AWS_SECRET_ACCESS_KEY: "fakeSecretAccessKey"
    AWS_REGION: "us-east-1"

